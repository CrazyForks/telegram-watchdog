# 公网域名（必须 HTTPS），Telegram webhook 会指向 ${DOMAIN}/webhook
DOMAIN=https://watchdog.example.com

# Telegram bot token（来自 @BotFather）
BOT_TOKEN=123456:ABC-...

# Webhook secret token（自己生成一段随机字符串）
BOT_SECRET=change-me-to-a-random-string

# 管理员 Telegram user ID
ADMIN_UID=123456789

# 管理群组 ID（可选；启用后开启 Forum Topic 模式）
ADMIN_GID=

# OpenAI 兼容 API 配置
LLM_API=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_KEY=sk-...

# Docker 部署相关（可选）
PORT=3000
DB_PATH=/data/watchdog.db
